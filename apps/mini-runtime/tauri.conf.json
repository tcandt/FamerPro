{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FarmerProMiniRuntime",
  "version": "1.0.0",
  "identifier": "com.farmerpro.miniruntime",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "FarmerPro Mini Auto-Tool Runtime",
        "width": 700,
        "height": 650,
        "minWidth": 380,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
