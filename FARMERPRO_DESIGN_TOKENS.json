  "layoutPx": {
    "titleBarHeight": 38,
    "commandBarHeight": 52,
    "navigationRailWidth": 64,
    "navigationExpandedWidth": 220,
    "nodePaletteWidth": 240,
    "inspectorWidth": 312,
    "executionDockDefaultHeight": 220,
    "minimumWindowWidth": 1120,
    "minimumWindowHeight": 700,
    "targetWidth": 1600,
    "targetHeight": 900
