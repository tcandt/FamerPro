      { "id": "n-tap", "type": "action.random_safe_tap", "position": { "x": 960, "y": 80 }, "config": { "targetRef": "n-find.target", "marginRatio": 0.18, "avoidRecentPoints": 5, "maxTargetAgeMs": 1500, "verificationRequired": true }, "timeoutMs": 10000 },
      { "id": "n-verify", "type": "verify.wait_for_image", "position": { "x": 1200, "y": 80 }, "config": { "templateRef": "assets/templates/example_quest_dialog.png", "minConfidence": 0.9 }, "timeoutMs": 10000 },
      { "id": "n-checkpoint", "type": "state.checkpoint", "position": { "x": 1440, "y": 80 }, "config": { "name": "quest_dialog_open" } },
